# ── Frontend (Vite) ────────────────────────────────────────────────────────
VITE_DATA_PROVIDER=api
VITE_API_BASE_URL=/api/v1
# Paystack public key — leave blank to keep the simulated demo checkout
VITE_PAYSTACK_PUBLIC_KEY=

# ── Compose / Postgres ─────────────────────────────────────────────────────
POSTGRES_USER=insurtech
POSTGRES_PASSWORD=insurtech
POSTGRES_DB=insurtech
POSTGRES_PORT=5432

# ── API ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://insurtech:insurtech@db:5432/insurtech
API_PREFIX=/api/v1
API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080
SECRET_KEY=change-me-in-production-jwt-ready
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
SEED_ON_STARTUP=true
DEMO_USER_PASSWORD=Password123!
ENABLE_DOCS=true
RUN_MIGRATIONS_ON_STARTUP=true
GRACEFUL_SHUTDOWN_SECONDS=30
# Paystack secret key — leave blank to keep the simulated demo checkout
PAYSTACK_SECRET_KEY=
